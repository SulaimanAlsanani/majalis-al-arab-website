<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="website_form_settings_majalis" model="ir.ui.view">
        <field name="name">res.config.settings.majalis.store</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="متجر مجالس العرب" name="majalis_luxe_store_settings" invisible="not website_id">
                    <setting string="تفعيل ثيم متجر مجالس العرب"
                             help="يعرض واجهة المطعم العربية في متجر الموقع المحدد.">
                        <field name="majalis_luxe_store"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
