<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_form_preparation_note" model="ir.ui.view">
        <field name="name">sale.order.form.majalis.preparation.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='note_group']//field[@name='note']" position="after">
                <field name="majalis_preparation_note" readonly="1" invisible="not majalis_preparation_note"/>
            </xpath>
        </field>
    </record>
</odoo>
